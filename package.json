    "next": "15.5.9",
    "next-mdx-remote": "^5.0.0",
    "react": "^18",
    "react-dom": "^18",
    "reading-time": "^1.5.0",
    "resend": "^6.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@next/eslint-plugin-next": "^15.5.5",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.37.0",
    "eslint-config-next": "15.4.1",
    "github-slugger": "^2.0.0",
