{
  "name": "ActARion-website",
  "version": "1.0.0",
  "description": "ActARion - Revolutionizing SOP Execution with Augmented Reality",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf .next out .velite",
    "prebuild": "npm run clean && velite build",
    "postbuild": "npm run type-check"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@vercel/analytics": "^1.5.0",
