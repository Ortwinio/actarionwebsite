    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.29.2",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.47.0",
    "velite": "^0.2.4"
